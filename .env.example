# Replace all three with different random values; never commit .env.
RADIO_TOKEN=replace-with-random-32-character-studio-key
ICECAST_SOURCE_PASSWORD=replace-with-random-source-password
ICECAST_ADMIN_PASSWORD=replace-with-random-admin-password
STATION_TIMEZONE=America/Bogota
# Set 1 behind HTTPS; keep 0 only for localhost HTTP.
COOKIE_SECURE=0
# Optional; billed to your API account. Keep server-side.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
